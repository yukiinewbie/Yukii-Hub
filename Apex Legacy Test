--[============================================================================]
-- YukiiUI Library (Modern "Tuff" Style with Built-in Config Saving & Asset IDs)
--[============================================================================]
local YukiiUI = {}
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = {
    Background = Color3.fromRGB(14, 14, 18),
    Container = Color3.fromRGB(20, 20, 26),
    Element = Color3.fromRGB(28, 28, 36),
    Accent = Color3.fromRGB(124, 58, 237), -- Vibrant Cyberpunk Violet
    AccentHover = Color3.fromRGB(139, 92, 246),
    Text = Color3.fromRGB(240, 240, 245),
    TextDark = Color3.fromRGB(150, 150, 165),
    Stroke = Color3.fromRGB(42, 42, 56)
}

function YukiiUI:CreateWindow(config)
    config = config or {}
    local title = config.Title or "Yukii Hub"
    local subtitle = config.SubTitle or "by Hrz"
    local folderName = config.FolderName or "YukiiHub"
    local fileName = config.FileName or "SaveData"
    
    local configPath = folderName .. "/" .. fileName .. ".json"
    local savedData = {}
    
    -- Config Load Subsystem
    pcall(function()
        if makefolder and not isfolder(folderName) then makefolder(folderName) end
        if readfile and isfile and isfile(configPath) then
            savedData = HttpService:JSONDecode(readfile(configPath))
        end
    end)
    
    local function SaveConfig()
        pcall(function()
            if writefile then
                writefile(configPath, HttpService:JSONEncode(savedData))
            end
        end)
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "YukiiUIRoot"
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.Parent = CoreGui

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.fromOffset(600, 420)
    MainFrame.Position = UDim2.fromScale(0.5, 0.5)
    MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    MainFrame.BackgroundColor3 = Theme.Background
    MainFrame.Parent = ScreenGui

    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 10)
    MainCorner.Parent = MainFrame

    local MainStroke = Instance.new("UIStroke")
    MainStroke.Color = Theme.Stroke
    MainStroke.Thickness = 1.5
    MainStroke.Parent = MainFrame

    -- Topbar / Draggable
    local Topbar = Instance.new("Frame")
    Topbar.Size = UDim2.new(1, 0, 0, 45)
    Topbar.BackgroundColor3 = Theme.Container
    Topbar.Parent = MainFrame

    local TopbarCorner = Instance.new("UICorner")
    TopbarCorner.CornerRadius = UDim.new(0, 10)
    TopbarCorner.Parent = Topbar

    -- Fix bottom corners of topbar
    local TopbarFix = Instance.new("Frame")
    TopbarFix.Size = UDim2.new(1, 0, 0, 10)
    TopbarFix.Position = UDim2.new(0, 0, 1, -10)
    TopbarFix.BackgroundColor3 = Theme.Container
    TopbarFix.BorderSizePixel = 0
    TopbarFix.Parent = Topbar

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(0, 200, 1, 0)
    TitleLabel.Position = UDim2.new(0, 15, 0, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.Text = title
    TitleLabel.TextColor3 = Theme.Text
    TitleLabel.TextSize = 15
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.Parent = Topbar

    local SubTitleLabel = Instance.new("TextLabel")
    SubTitleLabel.Size = UDim2.new(0, 150, 1, 0)
    SubTitleLabel.Position = UDim2.new(0, 110, 0, 0)
    SubTitleLabel.BackgroundTransparency = 1
    SubTitleLabel.Font = Enum.Font.Gotham
    SubTitleLabel.Text = subtitle
    SubTitleLabel.TextColor3 = Theme.Accent
    SubTitleLabel.TextSize = 12
    SubTitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    SubTitleLabel.Parent = Topbar

    -- Dragging Logic
    local dragging, dragInput, dragStart, startPos
    Topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                local delta = input.Position - dragStart
                MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end
    end)

    -- Navigation Bar (Tabs)
    local NavContainer = Instance.new("ScrollingFrame")
    NavContainer.Size = UDim2.new(0, 140, 1, -55)
    NavContainer.Position = UDim2.new(0, 10, 0, 50)
    NavContainer.BackgroundTransparency = 1
    NavContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
    NavContainer.ScrollBarThickness = 0
    NavContainer.Parent = MainFrame

    local NavLayout = Instance.new("UIListLayout")
    NavLayout.SortOrder = Enum.SortOrder.LayoutIndex
    NavLayout.Padding = UDim.new(0, 6)
    NavLayout.Parent = NavContainer

    -- Content Area
    local PagesContainer = Instance.new("Folder")
    PagesContainer.Name = "PagesContainer"
    PagesContainer.Parent = MainFrame

    local WindowObj = {}
    local firstTab = true

    function WindowObj:Tab(tabConfig)
        local tabName = tabConfig.Title or "Tab"
        local iconId = tabConfig.Icon -- Supports "rbxassetid://..."

        local TabPage = Instance.new("ScrollingFrame")
        TabPage.Size = UDim2.new(1, -165, 1, -55)
        TabPage.Position = UDim2.new(0, 155, 0, 50)
        TabPage.BackgroundTransparency = 1
        TabPage.CanvasSize = UDim2.new(0, 0, 0, 0)
        TabPage.ScrollBarThickness = 3
        TabPage.ScrollBarImageColor3 = Theme.Accent
        TabPage.Visible = false
        TabPage.Parent = PagesContainer

        local PageLayout = Instance.new("UIListLayout")
        PageLayout.SortOrder = Enum.SortOrder.LayoutIndex
        PageLayout.Padding = UDim.new(0, 8)
        PageLayout.Parent = TabPage

        PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabPage.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 15)
        end)

        local TabButton = Instance.new("TextButton")
        TabButton.Size = UDim2.new(1, 0, 0, 36)
        TabButton.BackgroundColor3 = Theme.Container
        TabButton.AutoButtonColor = false
        TabButton.Font = Enum.Font.GothamMedium
        TabButton.Text = "  " .. tabName
        TabPage.Name = tabName
        TabButton.TextColor3 = Theme.TextDark
        TabButton.TextSize = 13
        TabButton.TextXAlignment = Enum.TextXAlignment.Left
        TabButton.Parent = NavContainer

        local BtnCorner = Instance.new("UICorner")
        BtnCorner.CornerRadius = UDim.new(0, 6)
        BtnCorner.Parent = TabButton

        if iconId and iconId ~= "" then
            local Icon = Instance.new("ImageLabel")
            Icon.Size = UDim2.fromOffset(18, 18)
            Icon.Position = UDim2.new(0, 10, 0.5, -9)
            Icon.BackgroundTransparency = 1
            Icon.Image = iconId
            Icon.ImageColor3 = Theme.TextDark
            Icon.Parent = TabButton
            TitleLabel.Position = UDim2.new(0, 32, 0, 0) -- shift text if icon present
        end

        local function SelectTab()
            for _, p in pairs(PagesContainer:GetChildren()) do p.Visible = false end
            for _, b in pairs(NavContainer:GetChildren()) do
                if b:IsA("TextButton") then
                    b.BackgroundColor3 = Theme.Container
                    b.TextColor3 = Theme.TextDark
                end
            end
            TabPage.Visible = true
            TabButton.BackgroundColor3 = Theme.Accent
            TabButton.TextColor3 = Theme.Text
        end

        TabButton.MouseButton1Click:Connect(SelectTab)

        if firstTab then
            firstTab = false
            SelectTab()
        end

        local TabObj = {}

        function TabObj:Section(secConfig)
            local SecLabel = Instance.new("TextLabel")
            SecLabel.Size = UDim2.new(1, 0, 0, 24)
            SecLabel.BackgroundTransparency = 1
            SecLabel.Font = Enum.Font.GothamBold
            SecLabel.Text = string.upper(secConfig.Title or "SECTION")
            SecLabel.TextColor3 = Theme.TextDark
            SecLabel.TextSize = 11
            SecLabel.TextXAlignment = Enum.TextXAlignment.Left
            SecLabel.Parent = TabPage
        end

        function TabObj:Button(btnConfig)
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 36)
            Btn.BackgroundColor3 = Theme.Element
            Btn.AutoButtonColor = false
            Btn.Font = Enum.Font.GothamMedium
            Btn.Text = "  " .. (btnConfig.Title or "Button")
            Btn.TextColor3 = Theme.Text
            Btn.TextSize = 13
            Btn.TextXAlignment = Enum.TextXAlignment.Left
            Btn.Parent = TabPage

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 6)
            Corner.Parent = Btn

            Btn.MouseButton1Click:Connect(function()
                pcall(btnConfig.Callback)
            end)
        end

        function TabObj:Toggle(tglConfig)
            local flag = tglConfig.Flag or tglConfig.Title
            local state = savedData[flag] ~= nil and savedData[flag] or (tglConfig.Default or false)

            local ToggleBtn = Instance.new("TextButton")
            ToggleBtn.Size = UDim2.new(1, 0, 0, 36)
            ToggleBtn.BackgroundColor3 = Theme.Element
            ToggleBtn.AutoButtonColor = false
            ToggleBtn.Text = ""
            ToggleBtn.Parent = TabPage

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 6)
            Corner.Parent = ToggleBtn

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -50, 1, 0)
            Label.Position = UDim2.new(0, 12, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Font = Enum.Font.GothamMedium
            Label.Text = tglConfig.Title or "Toggle"
            Label.TextColor3 = Theme.Text
            Label.TextSize = 13
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = ToggleBtn

            local Box = Instance.new("Frame")
            Box.Size = UDim2.fromOffset(20, 20)
            Box.Position = UDim2.new(1, -30, 0.5, -10)
            Box.BackgroundColor3 = state and Theme.Accent or Theme.Container
            Box.Parent = ToggleBtn

            local BoxCorner = Instance.new("UICorner")
            BoxCorner.CornerRadius = UDim.new(0, 4)
            BoxCorner.Parent = Box

            local function Update(val)
                state = val
                savedData[flag] = state
                SaveConfig()
                Box.BackgroundColor3 = state and Theme.Accent or Theme.Container
                pcall(tglConfig.Callback, state)
            end

            ToggleBtn.MouseButton1Click:Connect(function()
                Update(not state)
            end)

            if state then pcall(tglConfig.Callback, true) end
            return {
                SetValue = function(_, v) Update(v) end
            }
        end

        function TabObj:Input(inpConfig)
            local flag = inpConfig.Flag or inpConfig.Title
            local value = savedData[flag] ~= nil and savedData[flag] or (inpConfig.Default or "")

            local Container = Instance.new("Frame")
            Container.Size = UDim2.new(1, 0, 0, 48)
            Container.BackgroundColor3 = Theme.Element
            Container.Parent = TabPage

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 6)
            Corner.Parent = Container

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -20, 0, 20)
            Label.Position = UDim2.new(0, 12, 0, 4)
            Label.BackgroundTransparency = 1
            Label.Font = Enum.Font.GothamMedium
            Label.Text = inpConfig.Title or "Input"
            Label.TextColor3 = Theme.TextDark
            Label.TextSize.TextSize = 11
            Label.TextSize = 11
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Container

            local TextBox = Instance.new("TextBox")
            TextBox.Size = UDim2.new(1, -24, 0, 20)
            TextBox.Position = UDim2.new(0, 12, 0, 22)
            TextBox.BackgroundTransparency = 1
            TextBox.Font = Enum.Font.Gotham
            TextBox.PlaceholderText = inpConfig.Placeholder or "Enter value..."
            TextBox.Text = tostring(value)
            TextBox.TextColor3 = Theme.Text
            TextBox.PlaceholderColor3 = Theme.TextDark
            TextBox.TextSize = 12
            TextBox.TextXAlignment = Enum.TextXAlignment.Left
            TextBox.ClearTextOnFocus = false
            TextBox.Parent = Container

            TextBox.FocusLost:Connect(function()
                savedData[flag] = TextBox.Text
                SaveConfig()
                pcall(inpConfig.Callback, TextBox.Text)
            end)

            if value ~= "" then pcall(inpConfig.Callback, value) end
            return Container
        end

        return TabObj
    end

    return WindowObj
end

return YukiiUI
